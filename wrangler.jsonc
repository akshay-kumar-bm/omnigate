{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infisical-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "24e5e7bc79544f20a3608707b592e1f3" }],
  "vars": {
    "INFISICAL_HOST": "https://us.infisical.com",
    "INFISICAL_PROJECT_ID": "e550c9ba-7757-4c6f-a3c2-ca83e8ec20b3",
    "DEFAULT_ENVIRONMENT": "dev",
    "ALLOWED_EMAILS": "akshaykumarbedre.bm@gmail.com,shipengine.ai@gmail.com",
    // Hosts each secret may be sent to by call_api. Deny by default; add a line per service, then redeploy.
    "API_HOSTS": "{\"NOTION_TOKEN\":[\"api.notion.com\"],\"GH_TOKEN\":[\"api.github.com\",\"uploads.github.com\"],\"GITHUB_TOKEN\":[\"api.github.com\",\"uploads.github.com\"],\"AWS_ACCESS_KEY_ID\":[\"*.amazonaws.com\"],\"AWS_SECRET_ACCESS_KEY\":[\"*.amazonaws.com\"],\"AWS_SESSION_TOKEN\":[\"*.amazonaws.com\"]}",
    "PUBLIC_URL": "https://infisical-mcp.shipengine-ai.workers.dev"
  },
  "observability": { "enabled": true }
}
