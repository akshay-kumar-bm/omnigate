{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infisical-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Approvals, sign-in sessions and nonces: strongly consistent storage (KV is eventually consistent).
  "durable_objects": { "bindings": [{ "name": "APPROVAL_STORE", "class_name": "ApprovalStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApprovalStore"] }],
  // run_code: each run is a fresh Dynamic Worker with no network; it can only call back through the Broker entrypoint.
  // Dynamic Workers need the Workers Paid plan. On the free plan this binding stays off and run_code says it is not set up;
  // after upgrading, uncomment the next line and deploy.
  // "worker_loaders": [{ "binding": "LOADER" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "${OAUTH_KV_ID}" }],
  // Values written as ${NAME} are filled in at deploy time from GitHub Actions variables (see README, "Deploying your own").
  "vars": {
    "INFISICAL_HOST": "https://us.infisical.com",
    "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}",
    "AGENT_PROJECT_ID": "${AGENT_PROJECT_ID}",
    "DEFAULT_ENVIRONMENT": "dev",
    "R2_ACCOUNT_ID": "${R2_ACCOUNT_ID}",
    "R2_BUCKET": "universal-api-uploads",
    "ALLOWED_EMAILS": "${ALLOWED_EMAILS}",
    "PUBLIC_URL": "${PUBLIC_URL}"
  },
  "observability": { "enabled": true }
}
