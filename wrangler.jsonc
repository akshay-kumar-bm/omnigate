{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infisical-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Approvals, sign-in sessions and nonces: strongly consistent storage (KV is eventually consistent).
  "durable_objects": { "bindings": [{ "name": "APPROVAL_STORE", "class_name": "ApprovalStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApprovalStore"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "24e5e7bc79544f20a3608707b592e1f3" }],
  "vars": {
    "INFISICAL_HOST": "https://us.infisical.com",
    "INFISICAL_PROJECT_ID": "e550c9ba-7757-4c6f-a3c2-ca83e8ec20b3",
    "AGENT_PROJECT_ID": "cd937b43-5001-4e01-b920-8e7ccc4ad52c",
    "DEFAULT_ENVIRONMENT": "dev",
    "R2_ACCOUNT_ID": "91f34fa3cd0f744088f5b34bf3e1e589",
    "R2_BUCKET": "universal-api-uploads",
    "ALLOWED_EMAILS": "akshaykumarbedre.bm@gmail.com,shipengine.ai@gmail.com",
    "PUBLIC_URL": "https://infisical-mcp.shipengine-ai.workers.dev"
  },
  "observability": { "enabled": true }
}
